# ==============================================================================
# NAZAR PLATFORM · PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# This template defines configuration for the production environment.
# Under NO circumstances commit real production values to version control.
# Injected at runtime via AWS Secrets Manager, HashiCorp Vault, or ECS Task Definition.

NODE_ENV=production
PORT=4000
API_PREFIX=v1
CORS_ORIGIN=https://nazar.app,https://admin.nazar.app
LOG_LEVEL=info
APP_NAME=nazar-api
APP_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

# Managed PostgreSQL 16 + PostGIS (Production Multi-AZ Private VPC)
# Sized per Gate 17: max_connections = 100, pool = 20 per API instance
DATABASE_URL=postgresql://nazar_prod_app:SECURE_PROD_PG_PASS@prod-db-primary.internal.nazar.app:5432/nazar_prod?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-ca-bundle.pem
DATABASE_POOL_MIN=4
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=3000

# Managed Redis 7 (Production Multi-AZ Cluster with TLS)
REDIS_URL=rediss://default:SECURE_PROD_REDIS_PASS@prod-redis.internal.nazar.app:6379/0

# Cryptographic Material & JWT Tokens (64-byte high-entropy cryptographic secrets)
JWT_ACCESS_SECRET=production_jwt_access_secret_cryptographically_secure_random_key_64
JWT_REFRESH_SECRET=production_jwt_refresh_secret_cryptographically_secure_random_key_64
FIELD_ENCRYPTION_KEY=production_field_encryption_key_cryptographically_secure_random_key_64
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000
JWT_ISSUER=https://api.nazar.app
JWT_AUDIENCE=https://nazar.app

# Auth & Passkey Configuration
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
EMAIL_VERIFICATION_EXPIRATION_SECONDS=900
GOOGLE_CLIENT_ID=prod-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.nazar.app.client
PASSKEY_RP_ID=nazar.app
PASSKEY_RP_NAME=Nazar Social Discovery
PASSKEY_ORIGIN=https://nazar.app

# Object Storage (Production AWS S3 / Cloudflare R2 - Dedicated Private Bucket)
S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com
S3_REGION=eu-west-2
S3_BUCKET_NAME=nazar-media-prod-london
S3_ACCESS_KEY_ID=AKIA_PROD_S3_KEY
S3_SECRET_ACCESS_KEY=SECURE_PROD_S3_SECRET
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_URL_PREFIX=https://media.nazar.app
MEDIA_UPLOAD_EXPIRY_SECONDS=900
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PHOTOS=6
MEDIA_MIN_PHOTOS=1

# Mobile Push Notifications (Production APNs / FCM Gateways)
APNS_BUNDLE_ID=com.nazar.app
APNS_TEAM_ID=PROD_APNS_TEAM
APNS_KEY_ID=PROD_APNS_KEY
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APNS_PRODUCTION=true
FCM_PROJECT_ID=nazar-production-firebase
PUSH_PROVIDER_MOCK=false

# In-App Purchases & Billing (Production App Store & Google Play APIs)
APPLE_BILLING_ENVIRONMENT=production
APPLE_BUNDLE_ID=com.nazar.app
GOOGLE_PLAY_PACKAGE_NAME=com.nazar.app
BILLING_PROVIDER_MOCK=false

# Gate 1A: Security hardening flags (server-controlled; never client-selectable)
# Apple/Google purchase & webhook processing lacks cryptographic verification
# until Gate 1C. Must remain false in staging/production (startup rejects true).
BILLING_ALLOW_UNVERIFIED_PROVIDERS=false
# Identity federation is disabled until signature verification ships (Gate 1B).
AUTH_GOOGLE_OAUTH_ENABLED=false
AUTH_APPLE_OAUTH_ENABLED=false
AUTH_PASSKEY_ENABLED=false
# One-time administrator provisioning enrollment secret (min 32 chars).
# Generate per-environment, deliver out-of-band, rotate after enrollment.
# ADMIN_PROVISIONING_TOKEN is REQUIRED to run `pnpm admin:provision` here.
ADMIN_PROVISIONING_TOKEN=
# MFA is enforced for admin login in staging/production by default.
ADMIN_MFA_REQUIRED=true
# Liveness/KYC challenge signing secret (required; no built-in default here).
VERIFICATION_SECRET=

# Google Gemini AI Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Observability (OpenTelemetry & Sentry)
OTEL_SERVICE_NAME=nazar-api-prod
OTEL_EXPORTER_OTLP_ENDPOINT=https://prod-collector.internal.nazar.app:4318
SENTRY_DSN=https://prod-dsn@sentry.io/7654321
