{
  "name": "@platform/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "build:export:ios": "expo export -p ios --no-bytecode",
    "build:export:android": "expo export -p android --no-bytecode",
    "build:manifest": "node scripts/generate-manifest.js",
    "test": "vitest run",
    "lint": "eslint app src --ext .ts,.tsx"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@platform/api-contracts": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/domain": "workspace:*",
    "@platform/ui": "workspace:*",
    "@platform/validation": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.16",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "^57.0.4",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "^13.0.0",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "^14.0.1",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "vitest": "^3.0.7"
  }
}
