# ==========================================
# NAZAR PLATFORM CONFIGURATION (EXAMPLE)
# ==========================================
# NOTE: DO NOT COMMIT REAL CREDENTIALS.
# Copy this file to .env for local development.

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=*

# PostgreSQL & PostGIS Configuration
DATABASE_URL=postgresql://nazar_user:nazar_password@localhost:5432/nazar_db
POSTGRES_USER=nazar_user
POSTGRES_PASSWORD=nazar_password
POSTGRES_DB=nazar_db
POSTGRES_PORT=5432

# Redis Cache & Ephemeral State
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nazar_redis_password
REDIS_URL=redis://:nazar_redis_password@localhost:6379/0

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=development_access_secret_do_not_use_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development_refresh_secret_do_not_use_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=30d

# Object Storage (MinIO local / Cloudflare R2 / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=nazar_minio_admin
S3_SECRET_ACCESS_KEY=nazar_minio_secret
S3_BUCKET_NAME=nazar-media
S3_PUBLIC_URL=http://localhost:9000/nazar-media
MINIO_ROOT_USER=nazar_minio_admin
MINIO_ROOT_PASSWORD=nazar_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Push Notifications (Mocked in development)
FCM_SERVER_KEY=mock_fcm_key
APNS_KEY_ID=mock_apns_key_id
APNS_TEAM_ID=mock_apns_team_id

# Google Gemini AI Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Observability (OpenTelemetry / Sentry)
OTEL_SERVICE_NAME=nazar-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
