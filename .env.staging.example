# ==============================================================================
# NAZAR PLATFORM · STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
# This template defines configuration for the staging environment.
# Real credentials must be injected securely via AWS Secrets Manager or Vault.

NODE_ENV=staging
PORT=4000
API_PREFIX=v1
CORS_ORIGIN=https://staging.nazar.app,https://admin-staging.nazar.app
LOG_LEVEL=info
APP_NAME=nazar-api
APP_VERSION=0.1.0-staging

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=300

# Managed PostgreSQL 16 + PostGIS (Staging VPC / Private Subnet)
DATABASE_URL=postgresql://nazar_staging_app:SECURE_STAGING_PG_PASS@staging-db.internal.nazar.app:5432/nazar_staging
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=3000

# Managed Redis 7 (Staging VPC / Private Subnet with TLS)
REDIS_URL=rediss://default:SECURE_STAGING_REDIS_PASS@staging-redis.internal.nazar.app:6379/0

# Cryptographic Material & JWT Tokens (Asymmetric or 64-char secrets)
JWT_ACCESS_SECRET=staging_jwt_access_secret_do_not_share_cryptographically_secure_key_64
JWT_REFRESH_SECRET=staging_jwt_refresh_secret_do_not_share_cryptographically_secure_key_64
FIELD_ENCRYPTION_KEY=staging_field_encryption_key_cryptographically_secure_random_key_64
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000
JWT_ISSUER=nazar-staging-api
JWT_AUDIENCE=nazar-staging-client

# Auth & Passkey Configuration
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
EMAIL_VERIFICATION_EXPIRATION_SECONDS=900
GOOGLE_CLIENT_ID=staging-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.nazar.app.staging.client
PASSKEY_RP_ID=staging.nazar.app
PASSKEY_RP_NAME=Nazar Staging
PASSKEY_ORIGIN=https://staging.nazar.app

# Object Storage (S3 / Cloudflare R2 - Staging Bucket)
S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com
S3_REGION=eu-west-2
S3_BUCKET_NAME=nazar-media-staging
S3_ACCESS_KEY_ID=AKIA_STAGING_S3_KEY
S3_SECRET_ACCESS_KEY=SECURE_STAGING_S3_SECRET
S3_FORCE_PATH_STYLE=false
MEDIA_PUBLIC_URL_PREFIX=https://cdn-staging.nazar.app
MEDIA_UPLOAD_EXPIRY_SECONDS=900
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PHOTOS=6
MEDIA_MIN_PHOTOS=1

# Mobile Push Notifications (Staging APNs Sandbox / FCM Staging)
APNS_BUNDLE_ID=com.nazar.app.staging
APNS_TEAM_ID=STAGING_APNS_TEAM
APNS_KEY_ID=STAGING_APNS_KEY
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APNS_PRODUCTION=false
FCM_PROJECT_ID=nazar-staging-firebase
PUSH_PROVIDER_MOCK=false

# In-App Purchases & Billing (Sandbox)
APPLE_BILLING_ENVIRONMENT=sandbox
APPLE_BUNDLE_ID=com.nazar.app.staging
GOOGLE_PLAY_PACKAGE_NAME=com.nazar.app.staging
BILLING_PROVIDER_MOCK=false

# Google Gemini AI Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Observability (OpenTelemetry & Sentry)
OTEL_SERVICE_NAME=nazar-api-staging
OTEL_EXPORTER_OTLP_ENDPOINT=https://staging-collector.internal.nazar.app:4318
SENTRY_DSN=https://staging-dsn@sentry.io/1234567

# Gate 1A: Security hardening flags (server-controlled; never client-selectable)
# Apple/Google purchase & webhook processing lacks cryptographic verification
# until Gate 1C. Must remain false in staging (startup rejects true).
BILLING_ALLOW_UNVERIFIED_PROVIDERS=false
# Identity federation is disabled until signature verification ships (Gate 1B).
AUTH_GOOGLE_OAUTH_ENABLED=false
AUTH_APPLE_OAUTH_ENABLED=false
AUTH_PASSKEY_ENABLED=false
# One-time administrator provisioning enrollment secret (min 32 chars).
# ADMIN_PROVISIONING_TOKEN is REQUIRED to run `pnpm admin:provision` here.
ADMIN_PROVISIONING_TOKEN=
# MFA is enforced for admin login in staging by default.
ADMIN_MFA_REQUIRED=true
# Liveness/KYC challenge signing secret (required; no built-in default here).
VERIFICATION_SECRET=
